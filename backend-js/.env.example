OUTPOST_ENV=development
OUTPOST_DATABASE_URL=postgresql://outpost:outpost-local-dev-only@127.0.0.1:5433/outpost
OUTPOST_VALKEY_URL=redis://127.0.0.1:6379/0
# OUTPOST_AUTH_SIGNING_KEY=<random-secret-at-least-32-bytes>
# OUTPOST_OTP_HMAC_KEY=<separate-random-secret-at-least-32-bytes>
OUTPOST_EMAIL_PROVIDER=smtp
OUTPOST_EMAIL_FROM_ADDRESS=no-reply@outpost.example
OUTPOST_EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
OUTPOST_PASSWORD_RESET_URL=http://localhost:5173/reset-password
OUTPOST_EMAIL_SMTP_HOST=127.0.0.1
OUTPOST_EMAIL_SMTP_PORT=1025
OUTPOST_EMAIL_SMTP_STARTTLS=false
OUTPOST_SMS_PROVIDER=development
# OUTPOST_GOOGLE_CLIENT_ID=<from-google>
# OUTPOST_GOOGLE_CLIENT_SECRET=<from-google>
OUTPOST_GOOGLE_HANDOFF_ENABLED=false
# OUTPOST_PUBLIC_APP_ORIGIN=https://<approved-host>
# OUTPOST_GOOGLE_REDIRECT_URI=https://<approved-host>/api/v1/auth/google/callback
# Private MinIO-compatible activity-plan storage; use separate credentials outside local development.
OUTPOST_OBJECT_ENDPOINT=http://127.0.0.1:9000
OUTPOST_OBJECT_BUCKET=outpost-activity-plans
OUTPOST_OBJECT_ACCESS_KEY=outpost
OUTPOST_OBJECT_SECRET_KEY=outpost-local-dev-only

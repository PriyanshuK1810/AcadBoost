  oldTimeZone String? @db.VarChar(100) @map("old_time_zone")
  dueAt DateTime? @db.Timestamptz(6) @map("due_at")
  timeZone String? @db.VarChar(100) @map("time_zone")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  week Week @relation(fields: [weekId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user User @relation(fields: [actorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([cohortId, createdAt, id], map: "ix_deadline_change_cohort_time")
  @@index([weekId], map: "ix_deadline_change_week")
  @@map("deadline_changes")
}

model ActivityPlan {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String          @db.Uuid @map("organization_id")
  uploadedBy          String          @db.Uuid @map("uploaded_by")
  name                String          @db.VarChar(200)
  filename            String          @db.VarChar(255)
  objectKey           String          @unique @db.VarChar(512) @map("object_key")
  sha256              String          @db.VarChar(64)
  byteCount           Int             @map("byte_count")
  pageCount           Int?            @map("page_count")
  status              String          @default("queued") @db.VarChar(16)
  failure             Json?
  pages               Json?
  proposal            Json?
  reviewItems         Json?           @map("review_items")
  warnings            Json?
  reviewConfirmed     Boolean         @default(false) @map("review_confirmed")
  revision            Int             @default(1)
  roadmapId           String?         @unique @db.Uuid @map("roadmap_id")
  versionId           String?         @unique @db.Uuid @map("version_id")
  createdAt           DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt           DateTime        @default(now()) @db.Timestamptz(6) @map("updated_at")
  processingStartedAt DateTime?       @db.Timestamptz(6) @map("processing_started_at")
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploader            User            @relation(fields: [uploadedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roadmap             Roadmap?        @relation(fields: [roadmapId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  version             RoadmapVersion? @relation(fields: [versionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, createdAt], map: "ix_activity_plans_organization_created")
  @@index([status, createdAt], map: "ix_activity_plans_status_created")
  @@map("activity_plans")
}

